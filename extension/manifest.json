{
  "manifest_version": 3,
  "name": "Husnexa",
  "version": "1.0.0",
  "description": "Adds a download button to YouTube videos. Requires the free Husnexa desktop app for Windows.",
  "key": "",
  "permissions": ["nativeMessaging", "cookies"],
  "host_permissions": ["https://*.youtube.com/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@husnexa",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "browsingActivity"]
      }
    }
  }
}
